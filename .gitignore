# --- R / RStudio ---
.Rproj.user/
.Rhistory
.RData
.Ruserdata
.Renviron

# --- macOS ---
.DS_Store

# --- targets store -------------------------------------------------------
# Regenerated by tar_make(). Several GB of fitted brms models; never committed.
_targets/

# --- Quarto render artifacts ---------------------------------------------
analysis_report_cache/
analysis_report_files/
analysis_report.html
model_selection_summary_files/
model_selection_summary.html

# --- Pipeline outputs ----------------------------------------------------
# Figures and tables are build products: regenerated by tar_make().
outputs/figures/*
outputs/tables/*
!outputs/**/.gitkeep

# --- Raw ERA5 GRIB downloads ---------------------------------------------
# ~32 MB; retrieved by scripts/a000_get_era5_data.py from the
# Copernicus CDS. The wrangled csv.gz extracts in data/proc/ ARE tracked.
data/external_data/

# --- data/proc -----------------------------------------------------------
# This directory holds two kinds of file: the derived inputs the pipeline reads
# (tracked, listed below, see data/README.md) and scratch output written by
# exploratory scripts (not tracked). Ignore everything, then re-admit the
# inputs explicitly so the repository stays a runnable clone.
data/proc/*
!data/proc/README.md
!data/proc/era5_2m_temperature.csv.gz
!data/proc/era5_2m_dewpoint_temperature.csv.gz
!data/proc/era5_10m_u_component_of_wind.csv.gz
!data/proc/era5_10m_v_component_of_wind.csv.gz
!data/proc/era5_surface_pressure.csv.gz
!data/proc/era5_total_precipitation.csv.gz
!data/proc/weather_era5_hourly.Rds
!data/proc/weather_era5_hourly_sundata.Rds
!data/proc/era5_daily.Rds
!data/proc/era5_daylight_daily.Rds
!data/proc/era5_albotime_daily.Rds
!data/proc/helix.Rds
!data/proc/hobos.Rds
!data/proc/hobos_sundata.Rds

# Headless-R graphics side effect of tar_make
Rplots.pdf
